{
  "name": "convite-casamento",
  "version": "1.0.0",
  "private": true,
  "description": "Convite de casamento digital — experiência interativa em papelaria de luxo (Next.js, TypeScript, Tailwind, Framer Motion, Prisma)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "guests:import": "tsx scripts/importar-convidados.ts",
    "guests:list": "tsx scripts/listar-convidados.ts",
    "art": "node scripts/art/generate.cjs && node scripts/art/og.cjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "framer-motion": "^14.9.0",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "postcss": "^8.5.32",
    "prisma": "^7.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
